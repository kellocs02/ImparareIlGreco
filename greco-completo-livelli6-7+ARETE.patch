+  localStorage.setItem(DB.KEY, "{rotto"); DB = boot(); assert.strictEqual(DB.totals().count, 0); assert.strictEqual(localStorage.getItem(DB.KEY + "-corrotto"), "{rotto"); assert.ok(DB.notice(), "l'avviso deve restare visibile anche dopo il primo salvataggio"); DB.clearNotice(); assert.strictEqual(DB.notice(), null);
+});
+t("spazio esaurito: l'errore viene segnalato invece di perdere i dati in silenzio", () => {
+  const real = localStorage.setItem; let seen = null; DB.onEvent((k, m) => (seen = m));
+  localStorage.setItem = () => { throw new Error("QuotaExceededError"); };
+  DB.exercises.add({ name: "Non salvabile", primary: "abs" }); localStorage.setItem = real;
+  assert.ok(seen && /spazio/.test(seen));
+});
+
+console.log(`\n${n} test superati, ${failed} falliti`);
+process.exit(failed ? 1 : 0);
