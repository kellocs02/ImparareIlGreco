+    return groups.map(([m, a]) => `<h2 class="ar-h2">${fmt.muscle(m)} <span class="cnt">${a.length}</span></h2>` + a.map((e) => `<button class="ar-card row link" data-act="lib-open" data-id="${e.id}"><div><b>${esc(e.name)}${e.custom ? ' <em class="pill">tuo</em>' : ""}</b><small>${esc(e.equipment || "—")}${e.secondary.length ? " · anche " + e.secondary.map((s) => fmt.muscle(s).toLowerCase()).join(", ") : ""}</small></div><span>›</span></button>`).join("")).join("");
+  }
+  A.screen("library", () => {
+    view.innerHTML = A.head("Esercizi", `${DB.exercises.list().length} esercizi`) +
+      `<input class="ar-in" id="libQ" data-inp="lib-q" placeholder="Cerca un esercizio…" value="${esc(st.q)}" autocomplete="off" aria-label="Cerca">
+       <div class="ar-chips scroll"><button class="ar-chip${st.muscle ? "" : " on"}" data-act="lib-m" data-m="">Tutti</button>${DB.MUSCLES.map((m) => `<button class="ar-chip${st.muscle === m ? " on" : ""}" data-act="lib-m" data-m="${m}">${fmt.muscle(m)}</button>`).join("")}</div>
